# Metasploit RPC credentials
# Required: set MSF_PASSWORD before starting the MCP server
MSF_USER=msf
MSF_PASSWORD=changeme

# RPC connection settings (defaults shown)
MSF_HOST=127.0.0.1
MSF_PORT=55553
MSF_SSL=false

# Aliases compatible with official msfmcpd (auto-mapped to MSF_* vars)
# MSF_API_HOST=127.0.0.1
# MSF_API_PORT=55553
# MSF_API_USER=msf
# MSF_API_PASSWORD=changeme
# MSF_API_SSL=false

# Logging level for the MCP server (DEBUG, INFO, WARNING, ERROR)
# MSF_LOG_LEVEL=INFO

# Active engagement ID (auto-detected if not set)
# MSF_ENGAGEMENT_ID=lab-default
